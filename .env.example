TZ=Asia/Jakarta
GDRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT=config/oauth-client.json
GOOGLE_OAUTH_TOKEN=config/token.json
OAUTH_PORT=8080
RETENTION_DAYS=30
CONFIG_PATH=config/config.yaml
BACKUP_DIR=tmp
INCREMENTAL=1
STATE_PATH=state/fingerprints.json

# --- MySQL backup (connections[].name di config.yaml) ---
# Contoh connection name: mypas
MYSQL_USER_MYPAS=
MYSQL_PASSWORD_MYPAS=

# --- Dashboard Clone DB (http://localhost:8095) ---
CLONE_REPL_USER=
CLONE_REPL_PASSWORD=

# Per node topology (nama persis seperti config: clone-13-30)
CLONE_MYSQL_USER_CLONE_13_30=
CLONE_MYSQL_PASSWORD_CLONE_13_30=
CLONE_MYSQL_USER_CLONE_13_31=
CLONE_MYSQL_PASSWORD_CLONE_13_31=
# Nama lama masih didukung: MONITOR_MYSQL_* / CLONE_MYSQL_PASSWORD_CLONE_96

CLONE_SSH_PASSWORD=

MONITOR_PORT=8090
MONITOR_HOST_PORT=8095
MONITOR_DATA_DIR=monitor-data
