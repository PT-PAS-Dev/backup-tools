TZ=Asia/Jakarta
GDRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT=config/oauth-client.json
GOOGLE_OAUTH_TOKEN=config/token.json
OAUTH_PORT=8080
RETENTION_DAYS=30
CONFIG_PATH=config/config.yaml
BACKUP_DIR=tmp
INCREMENTAL=1
STATE_PATH=state/fingerprints.json

# --- Dashboard Clone DB (http://localhost:8090) ---
# Bukan backup Drive. Service Docker: docker compose up monitor

# User replikasi di master .94 (buat manual di MariaDB)
CLONE_REPL_USER=
CLONE_REPL_PASSWORD=
# Nama lama: MONITOR_REPL_USER / MONITOR_REPL_PASSWORD

# Password MySQL ke server clone (contoh .96)
CLONE_MYSQL_PASSWORD_CLONE_96=
# Nama lama: MONITOR_MYSQL_PASSWORD_CLONE_96

CLONE_MYSQL_PASSWORD_CLONE_98=

# Password SSH ke Ubuntu clone (user di config.yaml: ssh_user)
CLONE_SSH_PASSWORD=
# Nama lama: MONITOR_SSH_PASSWORD / MONITOR_SSH_KEY

MONITOR_PORT=8090
MONITOR_DATA_DIR=monitor-data
